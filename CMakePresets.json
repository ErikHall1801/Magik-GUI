{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Cross-Platform Default",
      "description": "Uses vcpkg toolchain via VCPKG_ROOT environment variable",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        }
      }
    }
  ]
}